# Environment Variables
GEMINI_API_KEY=

# --- Admin panel: Supabase (recommended — edits go live instantly) ---------
# Supabase → Project Settings → API. The anon key is safe to expose; the
# database rules in supabase/schema.sql decide who may write.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin panel: static fallback (used only when Supabase isn't set) ------
# SHA-256 of "email:password" (the plain password is never stored).
# Generate it with:  npm run admin:hash -- you@example.com "your secret password"
VITE_ADMIN_HASH=
